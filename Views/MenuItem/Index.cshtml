@model List<Resturant_Project.Models.MenuItem>

@{
    ViewData["Title"] = "Menu Items";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1 class="fw-bold mb-0">
            Menu Items
        </h1>

        <a asp-controller="MenuItem"
           asp-action="Create"
           class="btn btn-primary">
            Add New Menu Item
        </a>

    </div>

    <div class="row g-4">

        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6 col-12">

                <div class="card h-100 border-0 shadow-sm">

                    <img src="@item.ImageUrl"
                         class="card-img-top"
                         style="height: 220px; object-fit: cover;"
                         alt="@item.Name">

                    <div class="card-body p-4">

                        <h4 class="fw-bold mb-2">
                            @item.Name
                        </h4>

                        <p class="text-muted mb-2">
                            @item.Description
                        </p>

                        <p class="mb-3">
                            <strong>Category:</strong>
                            @item.Category?.Name
                        </p>

                        <div class="d-flex justify-content-between align-items-center">

                            <span class="fw-bold">
                                @item.Price EGP
                            </span>

                            <div>

                                <a asp-controller="MenuItem"
                                   asp-action="Edit"
                                   asp-route-id="@item.MenuItemId"
                                   class="btn btn-warning me-2">
                                    Edit
                                </a>

                                <button type="button"
                                        class="btn btn-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal-@item.MenuItemId">
                                    Delete
                                </button>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Delete Modal -->

            <div class="modal fade"
                 id="deleteModal-@item.MenuItemId"
                 tabindex="-1"
                 aria-hidden="true">

                <div class="modal-dialog modal-dialog-centered">

                    <div class="modal-content">

                        <div class="modal-header">

                            <h5 class="modal-title fw-bold">
                                Delete Menu Item
                            </h5>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal">
                            </button>

                        </div>

                        <div class="modal-body text-center">

                            <h5 class="mb-3">
                                Are you sure you want to delete
                                <strong>@item.Name</strong>?
                            </h5>

                            <p class="text-muted mb-0">
                                This action cannot be undone.
                            </p>

                        </div>

                        <div class="modal-footer justify-content-center">

                            <button type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal">
                                Cancel
                            </button>

                            <form asp-controller="MenuItem"
                                  asp-action="DeleteConfirmed"
                                  method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@item.MenuItemId" />

                                <button type="submit"
                                        class="btn btn-danger">
                                    Delete
                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>
@model Resturant_Project.Models.MenuItem

@{
    ViewData["Title"] = "Add Menu Item";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h2 class="fw-bold mb-4">
                        Add New Menu Item
                    </h2>

                    <form asp-controller="MenuItem"
                          asp-action="Create"
                          method="post">

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="Name"
                                   class="form-label">
                                Item Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter item name" />

                        </div>

                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Enter item description"></textarea>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Price"
                                   class="form-label">
                                Price
                            </label>

                            <input asp-for="Price"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   placeholder="Enter price" />

                        </div>

                        <div class="mb-3">

                            <label asp-for="ImageUrl"
                                   class="form-label">
                                Image URL
                            </label>

                            <input asp-for="ImageUrl"
                                   class="form-control"
                                   placeholder="/img/burger.jfif" />

                        </div>

                        <div class="mb-4">

                            <label asp-for="CategoryId"
                                   class="form-label">
                                Category
                            </label>

                            <select asp-for="CategoryId"
                                    class="form-select">

                                <option value="">
                                    Select Category
                                </option>

                                @foreach (var category in ViewBag.Categories)
                                {
                                    <option value="@category.CategoryId">
                                        @category.Name
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-controller="MenuItem"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Back
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Add Menu Item
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>